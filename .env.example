APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=20000
DATABASE_URL=postgresql+psycopg://nextleap:nextleap@localhost:5432/nextleap
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
CACHE_RECOMMENDATION_TTL_SECONDS=300
CACHE_METADATA_TTL_SECONDS=900
RECOMMENDATION_RATE_LIMIT=20
METADATA_RATE_LIMIT=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=16384
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
TRUST_PROXY_HEADERS=false
GRACEFUL_SHUTDOWN_SECONDS=20
WEB_CONCURRENCY=1
RUN_MIGRATIONS=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=3
OTEL_EXPORTER_OTLP_ENDPOINT=
TELEMETRY_SERVICE_NAME=nextleap-api
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=4
MAX_LLM_CANDIDATES=12
MAX_PROMPT_CHARACTERS=20000
MAX_LLM_OUTPUT_TOKENS=700
LLM_REASONING_EFFORT=low
ACTIVE_PROMPT_VERSION=rank-v1
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30
LOG_LEVEL=INFO
INGESTION_MIN_ROWS=1
INGESTION_MAX_REJECTION_RATE=0.10
INGESTION_MAX_DUPLICATE_RATE=0.20
INGESTION_MIN_LOCATION_COVERAGE=0.90
INGESTION_MIN_CUISINE_COVERAGE=0.90
MAX_FILTERED_RECORDS=500
MAX_RESULTS=10
SCORING_CONFIG_VERSION=score-v1
